{
  "expo": {
    "name": "Shift & Thrive",
    "slug": "shiftandthrive",
    "scheme": "shiftandthrive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.shiftandthrive.app",
      "adaptiveIcon": {
        "backgroundColor": "#F6EFE4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "baecb8bf-70dd-44db-a16a-3a36feef37d6"
      }
    },
    "owner": "alainarja"
  }
}
